# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agent Identity Defaults
COMPANY_NAME=Home Credit India
AGENT_NAME=Pooja
AGENT_GENDER=female
DEFAULT_LANGUAGE=English

# Voice Platform Integrations (Retell AI / Bolna)
# Keep empty or set your test keys in your local .env (never commit .env)
VOICE_PLATFORM=retell
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret_here

BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here

# Optional LLM API Key (used only for natural conversational extraction fallback; engine operates deterministically without it)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
